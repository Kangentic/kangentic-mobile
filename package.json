{
  "name": "@kangentic/mobile",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kangentic/mobile.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "dev:mock": "node scripts/dev.mjs mock",
    "dev:shots": "node scripts/dev.mjs mock --shots",
    "dev:live": "node scripts/dev.mjs live",
    "dev:pair": "node scripts/dev.mjs pair",
    "dev:stub": "node scripts/dev.mjs stub",
    "dev:doctor": "node scripts/dev.mjs doctor",
    "check:install": "node scripts/checkInstallDrift.mjs",
    "clean:staging": "node scripts/cmakeStaging.mjs --prune",
    "verify:staging": "node scripts/cmakeStaging.mjs --verify",
    "pretypecheck": "node scripts/checkInstallDrift.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run tests/unit",
    "test:components": "jest tests/components",
    "sync:branding": "node scripts/syncBranding.mjs",
    "sync:branding:check": "node scripts/syncBranding.mjs --check",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "dev:emu": "node scripts/dev.mjs emu",
    "dev:adb": "node scripts/dev.mjs adb",
    "dev:stop": "node scripts/dev.mjs stop"
  },
  "dependencies": {
    "@bacons/text-decoder": "^0.0.0",
    "@kangentic/protocol": "^0.12.0",
    "@notifee/react-native": "9.1.8",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@xterm/addon-webgl": "0.19.0",
    "diff": "^9.0.0",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.13",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.17",
    "katex": "^0.17.0",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "^0.7.4",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@kangentic/branding": "^2.8.1",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/diff": "^7.0.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "qrcode": "^1.5.4",
    "react-test-renderer": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.19.0"
  }
}
